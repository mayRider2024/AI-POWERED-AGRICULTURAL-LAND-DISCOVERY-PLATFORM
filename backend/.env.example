# .env example for LandLens backend
# Copy this file to .env and adjust values as needed.
# DATABASE_URL follows SQLAlchemy URL format.
# Example for local PostgreSQL with PostGIS enabled:
# postgresql+psycopg://user:password@localhost:5432/landlens
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/landlens
# CORS origins for local development (React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
