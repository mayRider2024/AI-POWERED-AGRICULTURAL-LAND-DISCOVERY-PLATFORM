# LandLens AI — Environment Variables
# Fill in your project credentials from your Supabase Dashboard: Project Settings -> API

# Supabase Project URL (e.g. https://xcoufxenbsafjcmsyyds.supabase.co)
VITE_SUPABASE_URL=https://xcoufxenbsafjcmsyyds.supabase.co

# Supabase Anonymous Publishable Key (safe to use in client apps, NEVER use service-role key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend FastAPI URL (Render live production or local emulator)
VITE_API_URL=https://landlens-ai-api.onrender.com
